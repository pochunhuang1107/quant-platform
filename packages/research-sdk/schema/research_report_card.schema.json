{
  "$defs": {
    "ArtifactFormat": {
      "description": "Supported file formats for run artifact manifest entries.",
      "enum": [
        "json",
        "parquet",
        "markdown",
        "png",
        "svg",
        "html",
        "csv",
        "text"
      ],
      "title": "ArtifactFormat",
      "type": "string"
    },
    "ArtifactKind": {
      "description": "Run artifact categories recorded in artifact manifests.",
      "enum": [
        "config",
        "metrics",
        "trade_log",
        "signal_log",
        "daily_equity",
        "drawdown_series",
        "monthly_returns",
        "regime_breakdown",
        "failure_analysis",
        "research_note",
        "chart",
        "log",
        "diagnostic",
        "other"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "ArtifactStatus": {
      "description": "Production status for a run artifact manifest entry.",
      "enum": [
        "produced",
        "missing",
        "failed",
        "skipped"
      ],
      "title": "ArtifactStatus",
      "type": "string"
    },
    "AssetClass": {
      "description": "Supported high-level asset classes for research contracts.",
      "enum": [
        "equities",
        "etfs",
        "futures",
        "fx",
        "crypto",
        "indices",
        "options",
        "mixed"
      ],
      "title": "AssetClass",
      "type": "string"
    },
    "AssetUniverseReference": {
      "additionalProperties": false,
      "description": "Reference to a point-in-time asset universe.",
      "properties": {
        "as_of": {
          "anyOf": [
            {
              "$ref": "#/$defs/UtcDatetime"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "symbols": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/NonEmptyString"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Symbols"
        },
        "universe_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonEmptyString"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "AssetUniverseReference",
      "type": "object"
    },
    "DataAdjustmentPolicy": {
      "description": "Adjustment policy labels for data snapshot manifests.",
      "enum": [
        "raw",
        "split_adjusted",
        "total_return",
        "continuous",
        "other"
      ],
      "title": "DataAdjustmentPolicy",
      "type": "string"
    },
    "ExperimentRunStatus": {
      "description": "Allowed experiment ledger run statuses.",
      "enum": [
        "created",
        "running",
        "completed",
        "under_review",
        "accepted",
        "rejected",
        "failed",
        "invalid",
        "superseded",
        "cancelled"
      ],
      "title": "ExperimentRunStatus",
      "type": "string"
    },
    "NonEmptyString": {
      "minLength": 1,
      "type": "string"
    },
    "RandomSeedMetadata": {
      "additionalProperties": false,
      "description": "Random seed metadata for stochastic or explicitly deterministic runs.",
      "properties": {
        "rationale": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonEmptyString"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Seed"
        }
      },
      "required": [
        "seed"
      ],
      "title": "RandomSeedMetadata",
      "type": "object"
    },
    "ReportCardArtifactEvidenceEntry": {
      "additionalProperties": false,
      "description": "Immutable evidence copied from a run artifact manifest entry.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "artifact_kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "content_hash": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "filename": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "format": {
          "$ref": "#/$defs/ArtifactFormat"
        },
        "row_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row Count"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/ArtifactStatus"
        },
        "uri": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "validator_version": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonEmptyString"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "artifact_id",
        "artifact_kind",
        "filename",
        "uri",
        "format",
        "status",
        "content_hash",
        "size_bytes"
      ],
      "title": "ReportCardArtifactEvidenceEntry",
      "type": "object"
    },
    "ReportCardAssumptions": {
      "additionalProperties": false,
      "description": "Deterministic assumptions copied from run and snapshot contracts.",
      "properties": {
        "adjustment_policy": {
          "$ref": "#/$defs/DataAdjustmentPolicy"
        },
        "calendar": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "corporate_action_policy": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "cost_model": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "lag_assumptions": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "leakage_review": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "lookback": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "random_seed": {
          "$ref": "#/$defs/RandomSeedMetadata"
        },
        "slippage_model": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "survivorship_policy": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "temporal_coverage": {
          "$ref": "#/$defs/TemporalCoverage"
        },
        "timezone": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "universe_membership_policy": {
          "$ref": "#/$defs/NonEmptyString"
        }
      },
      "required": [
        "cost_model",
        "slippage_model",
        "lookback",
        "lag_assumptions",
        "leakage_review",
        "random_seed",
        "adjustment_policy",
        "temporal_coverage",
        "corporate_action_policy",
        "survivorship_policy",
        "universe_membership_policy",
        "calendar",
        "timezone"
      ],
      "title": "ReportCardAssumptions",
      "type": "object"
    },
    "ReportCardEvidence": {
      "additionalProperties": false,
      "description": "Artifact evidence summarized by the report card.",
      "properties": {
        "artifact_manifest_uri": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "artifact_root_uri": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "artifacts": {
          "items": {
            "$ref": "#/$defs/ReportCardArtifactEvidenceEntry"
          },
          "minItems": 1,
          "title": "Artifacts",
          "type": "array"
        },
        "required_artifacts_complete": {
          "title": "Required Artifacts Complete",
          "type": "boolean"
        }
      },
      "required": [
        "artifact_root_uri",
        "artifact_manifest_uri",
        "required_artifacts_complete",
        "artifacts"
      ],
      "title": "ReportCardEvidence",
      "type": "object"
    },
    "ReportCardLimitations": {
      "additionalProperties": false,
      "description": "Known source and report-card limitations.",
      "properties": {
        "source_snapshot_known_limitations": {
          "items": {
            "$ref": "#/$defs/NonEmptyString"
          },
          "minItems": 1,
          "title": "Source Snapshot Known Limitations",
          "type": "array"
        }
      },
      "required": [
        "source_snapshot_known_limitations"
      ],
      "title": "ReportCardLimitations",
      "type": "object"
    },
    "ReportCardLineage": {
      "additionalProperties": false,
      "description": "Source lineage copied from immutable experiment-ledger records.",
      "properties": {
        "artifact_manifest_hash": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "artifact_manifest_id": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "benchmark_snapshot_content_hash": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "benchmark_snapshot_id": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "config_hash": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "data_snapshot_content_hash": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "data_snapshot_id": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "engine_version": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "git_commit_sha": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "parameter_hash": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "strategy_id": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "strategy_version": {
          "$ref": "#/$defs/NonEmptyString"
        }
      },
      "required": [
        "strategy_id",
        "strategy_version",
        "engine_version",
        "git_commit_sha",
        "data_snapshot_id",
        "benchmark_snapshot_id",
        "data_snapshot_content_hash",
        "benchmark_snapshot_content_hash",
        "artifact_manifest_id",
        "config_hash",
        "parameter_hash",
        "artifact_manifest_hash"
      ],
      "title": "ReportCardLineage",
      "type": "object"
    },
    "ReportCardMetrics": {
      "additionalProperties": false,
      "description": "Approved scalar metric set for deterministic report cards.",
      "properties": {
        "benchmark_total_return": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "ending_equity": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "excess_return": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "maximum_drawdown": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "number_of_trades": {
          "minimum": 0,
          "title": "Number Of Trades",
          "type": "integer"
        },
        "observation_count": {
          "minimum": 0,
          "title": "Observation Count",
          "type": "integer"
        },
        "realized_commission": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "realized_slippage": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "total_return": {
          "$ref": "#/$defs/NonEmptyString"
        }
      },
      "required": [
        "total_return",
        "benchmark_total_return",
        "excess_return",
        "maximum_drawdown",
        "realized_commission",
        "realized_slippage",
        "ending_equity",
        "number_of_trades",
        "observation_count"
      ],
      "title": "ReportCardMetrics",
      "type": "object"
    },
    "ReportCardResearchScope": {
      "additionalProperties": false,
      "description": "Experiment scope summarized by the report card.",
      "properties": {
        "asset_class": {
          "$ref": "#/$defs/AssetClass"
        },
        "asset_universe": {
          "$ref": "#/$defs/AssetUniverseReference"
        },
        "benchmark_id": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "end_date": {
          "format": "date",
          "title": "End Date",
          "type": "string"
        },
        "frequency": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "observation_count": {
          "minimum": 0,
          "title": "Observation Count",
          "type": "integer"
        },
        "source_run_status": {
          "$ref": "#/$defs/ExperimentRunStatus"
        },
        "start_date": {
          "format": "date",
          "title": "Start Date",
          "type": "string"
        }
      },
      "required": [
        "asset_class",
        "asset_universe",
        "benchmark_id",
        "frequency",
        "start_date",
        "end_date",
        "observation_count",
        "source_run_status"
      ],
      "title": "ReportCardResearchScope",
      "type": "object"
    },
    "ReportCardUseRestriction": {
      "description": "Stable use restrictions for deterministic report-card evidence.",
      "enum": [
        "research_generated_synthetic_data",
        "infrastructure_validation_only",
        "no_investment_performance_claim",
        "not_production_data_research",
        "not_paper_trading_evidence",
        "not_live_trading_evidence"
      ],
      "title": "ReportCardUseRestriction",
      "type": "string"
    },
    "SchemaVersion": {
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
      "type": "string"
    },
    "TemporalCoverage": {
      "description": "Point-in-time semantics for a data snapshot.",
      "enum": [
        "point_in_time",
        "first_available",
        "latest_known",
        "mixed",
        "not_applicable"
      ],
      "title": "TemporalCoverage",
      "type": "string"
    },
    "UtcDatetime": {
      "format": "date-time",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Deterministic evidence summary derived from immutable research records.",
  "properties": {
    "assumptions": {
      "$ref": "#/$defs/ReportCardAssumptions"
    },
    "derivation_policy_version": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "evidence": {
      "$ref": "#/$defs/ReportCardEvidence"
    },
    "experiment_id": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "limitations": {
      "$ref": "#/$defs/ReportCardLimitations"
    },
    "lineage": {
      "$ref": "#/$defs/ReportCardLineage"
    },
    "metrics": {
      "$ref": "#/$defs/ReportCardMetrics"
    },
    "report_card_id": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "research_scope": {
      "$ref": "#/$defs/ReportCardResearchScope"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    },
    "source_run_id": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "use_restrictions": {
      "items": {
        "$ref": "#/$defs/ReportCardUseRestriction"
      },
      "minItems": 1,
      "title": "Use Restrictions",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "report_card_id",
    "derivation_policy_version",
    "source_run_id",
    "experiment_id",
    "lineage",
    "research_scope",
    "assumptions",
    "metrics",
    "evidence",
    "limitations",
    "use_restrictions"
  ],
  "title": "ResearchReportCard",
  "type": "object"
}
