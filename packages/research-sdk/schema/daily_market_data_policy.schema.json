{
  "$defs": {
    "AssetClass": {
      "description": "Supported high-level asset classes for research contracts.",
      "enum": [
        "equities",
        "etfs",
        "futures",
        "fx",
        "crypto",
        "indices",
        "options",
        "mixed"
      ],
      "title": "AssetClass",
      "type": "string"
    },
    "DataAdjustmentPolicy": {
      "description": "Adjustment policy labels for data snapshot manifests.",
      "enum": [
        "raw",
        "split_adjusted",
        "total_return",
        "continuous",
        "other"
      ],
      "title": "DataAdjustmentPolicy",
      "type": "string"
    },
    "DistributionTreatment": {
      "description": "Explicit distribution handling for daily market-data research policy.",
      "enum": [
        "explicit_cash",
        "excluded_price_return_only"
      ],
      "title": "DistributionTreatment",
      "type": "string"
    },
    "NonEmptyString": {
      "minLength": 1,
      "type": "string"
    },
    "SchemaVersion": {
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Versioned provider-neutral daily market-data policy.",
  "properties": {
    "adjustment_policy": {
      "$ref": "#/$defs/DataAdjustmentPolicy"
    },
    "asset_class": {
      "$ref": "#/$defs/AssetClass"
    },
    "calendar": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "canonicalization_version": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "corporate_action_policy": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "delisting_policy": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "distribution_treatment": {
      "$ref": "#/$defs/DistributionTreatment"
    },
    "frequency": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "policy_id": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "quality_policy_version": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    },
    "survivorship_policy": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "timezone": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "universe_membership_policy": {
      "$ref": "#/$defs/NonEmptyString"
    }
  },
  "required": [
    "schema_version",
    "policy_id",
    "asset_class",
    "frequency",
    "calendar",
    "timezone",
    "adjustment_policy",
    "distribution_treatment",
    "corporate_action_policy",
    "universe_membership_policy",
    "survivorship_policy",
    "delisting_policy",
    "canonicalization_version",
    "quality_policy_version"
  ],
  "title": "DailyMarketDataPolicy",
  "type": "object"
}
